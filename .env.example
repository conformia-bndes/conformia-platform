# ==============================================================================
# Conform.IA BNDES Platform - Variáveis de Ambiente
# Modelo de configuração para desenvolvimento local e contêineres Docker
# ==============================================================================

# --- Aplicação e Ambiente ---
PROJECT_NAME="Conform.IA BNDES Platform"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=conformia_super_secret_dev_key_change_in_production_98765
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Portas dos Serviços Locais ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Banco de Dados Relacional (PostgreSQL 16) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=conformia_user
POSTGRES_PASSWORD=conformia_secret_pass
POSTGRES_DB=conformia_db
DATABASE_URL=postgresql://conformia_user:conformia_secret_pass@localhost:5432/conformia_db

# --- Seguranca e Autenticacao ---
API_KEY=conformia_dev_api_key_2026

# --- Mensageria e Cache (Redis 7 & Celery) ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# --- Armazenamento de Objetos (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=conformia_minio_admin
MINIO_ROOT_PASSWORD=conformia_minio_secret
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=False

# --- Motor de Regras e IDP ---
RULES_PATH=rules/schemas
RULES_FILE_PATH=rules/schemas/bndes_sample_checklist.json
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/

# --- Inteligência Artificial & LLM (Opcional para Mock local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
