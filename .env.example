# ==============================================================================
# Conform.IA BNDES Platform - Variaveis de Ambiente (MODELO)
#
# Este arquivo e versionado e NAO contem segredos reais. Todo valor CHANGE_ME e
# substituido por um valor aleatorio ao rodar:
#
#     make env        (ou: bash scripts/setup-env.sh)
#
# O arquivo gerado (.env) esta no .gitignore e nunca deve ser commitado.
# ==============================================================================

# --- Aplicacao e Ambiente ---
PROJECT_NAME="Conform.IA BNDES Platform"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=CHANGE_ME
API_KEY=CHANGE_ME
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Portas expostas no host (dentro da rede Docker as portas sao fixas) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL 16 ---
POSTGRES_USER=conformia_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=conformia_db

# --- MinIO (S3 compativel) ---
# Imagem: o repositorio oficial minio/minio foi arquivado e saiu do Docker Hub em 2025/2026;
# usamos o fork mantido pgsty/minio. Fixe uma tag (ou digest) depois de validar.
MINIO_IMAGE=pgsty/minio:latest
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=False

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Motor de Regras e IDP ---
RULES_PATH=/rules/schemas

# --- Inteligencia Artificial & LLM (opcional; vazio = modo mock local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Execucao FORA do Docker (uv run / pytest direto no host)? Aponte para os
# servicos publicados no host; dentro dos containers o compose ja sobrescreve:
#   DATABASE_URL=postgresql://conformia_user:<senha>@localhost:5432/conformia_db
#   REDIS_URL=redis://localhost:6380/0
#   MINIO_ENDPOINT=localhost:9000
# ------------------------------------------------------------------------------
