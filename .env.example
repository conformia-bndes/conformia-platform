# ==============================================================================
# Conform.IA BNDES Platform - Variaveis de Ambiente (MODELO)
#
# Este arquivo e versionado e NAO contem segredos reais. Todo valor CHANGE_ME e
# substituido por um valor aleatorio ao rodar:
#
#     make env        (ou: bash scripts/setup-env.sh)
#
# O arquivo gerado (.env) esta no .gitignore e nunca deve ser commitado.
# ==============================================================================

# --- Aplicacao e Ambiente ---
PROJECT_NAME="Conform.IA BNDES Platform"
# Os padroes do codigo sao seguros (ENVIRONMENT=production, DEBUG=False, sem acesso anonimo).
# Este modelo liga o perfil de DESENVOLVIMENTO LOCAL de forma explicita. Na demonstracao ou em
# qualquer deploy, use ENVIRONMENT=production, DEBUG=False, ALLOW_ANONYMOUS_ACCESS=false e
# cadastre os usuarios em API_USERS; a aplicacao recusa iniciar em production com DEBUG ou
# acesso anonimo ativos.
ENVIRONMENT=development
DEBUG=True
ALLOW_ANONYMOUS_ACCESS=true
SECRET_KEY=CHANGE_ME
API_KEY=CHANGE_ME
# Usuarios com chave pessoal (lista JSON em uma linha). Obrigatorio para a revisao humana:
# propor e confirmar decisoes exige dois usuarios ANALISTA distintos. Gere cada entrada com
#   python backend/scripts/create_api_user.py <user_id> <ANALISTA|AUDITOR|ADMIN>
# A chave entregue ao usuario tem o formato <user_id>:<segredo>; aqui fica so o hash PBKDF2.
# Coloque o JSON entre aspas simples: o key_hash contem "$", que o Docker Compose interpolaria.
# Exemplo: API_USERS='[{"user_id":"ana.silva","role":"ANALISTA","key_hash":"pbkdf2_sha256$200000$<sal>$<hash>"}]'
API_USERS=[]
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Portas expostas no host (dentro da rede Docker as portas sao fixas) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL 16 ---
POSTGRES_USER=conformia_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=conformia_db

# --- Redis 7 (Broker Celery & Cache) ---
# Senha exigida pelo Redis (requirepass); entra nas URLs do broker e do result backend.
# Gerada por 'make env'. Em um .env antigo, acrescente com: bash scripts/setup-env.sh --sync
REDIS_PASSWORD=CHANGE_ME

# --- Concorrencia, Pool de Conexoes e Limites de Recursos ---
# Conexoes com o Postgres = (WEB_CONCURRENCY + CELERY_CONCURRENCY) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# Mantenha abaixo do max_connections do Postgres (100 por padrao). O worker usa ~900 MB no OCR.
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1024M
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2048M
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=512M

# --- MinIO (S3 compativel) ---
# Imagem: o repositorio oficial minio/minio foi arquivado e saiu do Docker Hub em 2025/2026;
# usamos o fork mantido pgsty/minio. Fixe uma tag (ou digest) depois de validar.
MINIO_IMAGE=pgsty/minio:latest
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=False

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Motor de Regras e IDP ---
RULES_PATH=/rules/schemas

# --- Inteligencia Artificial & LLM (opcional; vazio = regras HYBRID vao para revisao manual) ---
# OPENAI_API_KEY e a chave do provedor configurado em LLM_BASE_URL (OpenAI, OpenRouter...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
# Base de um provedor compativel com a API da OpenAI. Exemplos:
#   OpenRouter: https://openrouter.ai/api/v1 (modelo gratuito avaliado: particle-ai/particle-1:free)
#   Ollama:     http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
# Tempo maximo por chamada e tentativas extras em 429/5xx (espera de 2 s, 4 s, ...). Modelos
# gratuitos sao mais lentos e sofrem limite de taxa: use 60 e 2.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Execucao FORA do Docker (uv run / pytest direto no host)? Aponte para os
# servicos publicados no host; dentro dos containers o compose ja sobrescreve:
#   DATABASE_URL=postgresql://conformia_user:<senha>@localhost:5432/conformia_db
#   REDIS_URL=redis://:<senha>@localhost:6380/0
#   MINIO_ENDPOINT=localhost:9000
# ------------------------------------------------------------------------------
