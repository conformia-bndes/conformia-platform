# ==============================================================================
# Conform.IA BNDES Platform - Frontend Dockerfile
# Multi-stage build Node 22 / Vite / React / TypeScript / Nginx
# ==============================================================================

# Imagens fixadas por digest; o Dependabot (ecossistema docker) atualiza tag e digest juntos.

# Stage 1: Development
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS development

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci

COPY frontend/ ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# Stage 2: Builder
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 3: Production (Nginx)
FROM nginx:1.31-alpine@sha256:713fc2ebfd92e8217db451477182ee91944b123d2b1ee9fd5a8c6e91ca6c3a11 AS production

# Aplica as correcoes de seguranca do Alpine publicadas depois do digest fixado acima
# (a base e atualizada pelo Dependabot, mas as bibliotecas do sistema costumam receber
# patches antes disso).
# O ARG invalida o cache desta camada: sem ele, o cache do CI reaproveita um `apk upgrade`
# antigo e a imagem sai sem as correcoes ja publicadas no Alpine (falha do Trivy). O CI passa a data.
ARG UPGRADE_STAMP=local
RUN echo "apk upgrade em ${UPGRADE_STAMP}" && apk upgrade --no-cache

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

# Roda como usuario sem privilegio: o nginx so precisa escrever em cache, logs e no pid.
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid
USER 101

# Porta acima de 1024 (usuario sem privilegio nao abre a 80).
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/"]

CMD ["nginx", "-g", "daemon off;"]
