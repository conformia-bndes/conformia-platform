# ==============================================================================
# Conform.IA BNDES Platform - Backend Dockerfile
# Multi-stage build Python 3.11 com Tesseract OCR, Poppler e dependências IDP
# ==============================================================================

# Stage 1: Build & Wheels
# Imagens fixadas por digest; o Dependabot (ecossistema docker) atualiza tag e digest juntos.
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /build

# Instala direto do uv.lock (mesma fonte de versoes do desenvolvimento e do CI), com hashes
# verificados, somente as dependencias de runtime do backend: sem as ferramentas de
# documentacao do workspace e sem dependencias de desenvolvimento. Todas tem wheel binario,
# entao o estagio nao precisa de compiladores.
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/pyproject.toml
RUN uv sync --frozen --no-cache --no-dev --no-install-workspace --package conformia-backend

# Stage 2: Runtime Environment
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/

WORKDIR /app

# Instalação de utilitários de sistema essenciais para processamento documental (OCR / PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-por \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copia ambiente virtual pré-compilado do builder
COPY --from=builder /opt/venv /opt/venv

# Cria usuário não-root para segurança operacional
RUN useradd -m -u 1000 conformia && \
    chown -R conformia:conformia /app

# Copia o código da aplicação
COPY --chown=conformia:conformia ./backend /app

# Porta padrão FastAPI
EXPOSE 8000

# Execução com usuário não-root
USER conformia

# Execução padrão (sobrescrita no docker-compose para hot-reload e workers)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
