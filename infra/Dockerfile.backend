# ==============================================================================
# Conform.IA BNDES Platform - Backend Dockerfile
# Multi-stage build Python 3.11 com Tesseract OCR, Poppler e dependências IDP
# ==============================================================================

# Stage 1: Build & Wheels
# Imagens fixadas por digest; o Dependabot (ecossistema docker) atualiza tag e digest juntos.
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /build

# Instala direto do uv.lock (mesma fonte de versoes do desenvolvimento e do CI), com hashes
# verificados, somente as dependencias de runtime do backend: sem as ferramentas de
# documentacao do workspace e sem dependencias de desenvolvimento. Todas tem wheel binario,
# entao o estagio nao precisa de compiladores.
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/pyproject.toml
RUN uv sync --frozen --no-cache --no-dev --no-install-workspace --package conformia-backend

# Stage 2: Runtime Environment
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/ \
    WEB_CONCURRENCY=2

# WEB_CONCURRENCY: processos do uvicorn (lido pelo proprio uvicorn). Ajuste por replica conforme
# a CPU; conexoes totais com o banco = workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW).

WORKDIR /app

# Instalação de utilitários de sistema essenciais para processamento documental (OCR / PDF).
# Versoes dos pacotes apt nao sao fixadas de proposito: o Debian so mantem a versao corrente de
# cada pacote, e fixar impediria receber correcoes de seguranca.
# apt, libapt-pkg7.0 e zlib1g ja vem na base, mas a base fixada por digest ainda traz versoes com
# CVEs HIGH apontados pelo Trivy (apt/libapt-pkg7.0 CVE-2026-109518, corrigido na 3.0.4; zlib1g
# CVE-2026-76844 e CVE-2026-85091, corrigidos em 1.3.dfsg+really1.3.1-1+deb13u1). Lista-los aqui
# faz o apt-get install atualiza-los para a versao corrente. Quando o digest da base ja incluir
# as correcoes, estas tres linhas viram no-op e podem ser removidas.
# O ARG invalida o cache desta camada: sem ele o cache do CI reaproveita um `apt-get install`
# antigo (libpq5 17.11, zlib1g...) e o Trivy reprova a imagem por CVEs ja corrigidos no Debian.
# O CI passa a data UTC; localmente o valor fixo "local" mantem o cache.
ARG UPGRADE_STAMP=local
# hadolint ignore=DL3008
RUN echo "apt em ${UPGRADE_STAMP}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-por \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libpq5 \
    curl \
    apt \
    libapt-pkg7.0 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# O app roda no venv copiado abaixo; pip, setuptools e wheel do Python do sistema nao sao
# usados em runtime. Remove-los elimina CVEs de pacotes embutidos (jaraco.context e wheel
# vendorizados no setuptools) e reduz a superficie de ataque.
RUN python -m pip uninstall -y setuptools wheel pip \
    && rm -rf /root/.cache

# Copia ambiente virtual pré-compilado do builder
COPY --from=builder /opt/venv /opt/venv

# Cria usuário não-root para segurança operacional
RUN useradd -m -u 1000 conformia && \
    chown -R conformia:conformia /app

# Copia o código da aplicação
COPY --chown=conformia:conformia ./backend /app

# Porta padrão FastAPI
EXPOSE 8000

# Execução com usuário não-root
USER 1000

# Execução padrão (sobrescrita no docker-compose para hot-reload e workers)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
